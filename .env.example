# ---- Required ----

# Collection URL (no project segment).
#   On-prem: https://your-tfs-server.company.com/tfs/YourCollection
#   Cloud:   https://dev.azure.com/your-organization
AZURE_DEVOPS_ORG_URL=https://your-tfs-server.company.com/tfs/YourCollection

# Project name inside the collection.
AZURE_DEVOPS_PROJECT=YourProjectName

# Personal Access Token (https://<your-tfs>/_usersSettings/tokens).
# See README "Prerequisites" for the scope table.
AZURE_DEVOPS_PAT=your_pat_token_here

# ---- Connection options ----

# Custom display name shown in the MCP client. Auto-derived from ORG_URL if omitted
# (e.g. dev.azure.com/acme → "acme"; tfs.example.com/tfs/CompanyOrg → "CompanyOrg").
# AZURE_DEVOPS_SERVER_NAME=CustomDisplayName

# Skip SSL validation. Needed for self-signed or corporate CA certs on on-prem TFS.
# AZURE_DEVOPS_SSL_IGNORE=true

# ---- Tool filtering ----

# Restrict which tool domains load (smaller AI tool list, fewer mis-selections).
# Unknown names fail startup — no silent typos. Default loads all 7.
# Valid: work_items, git, tfvc, pipelines, wiki, test_plans, convenience
# See README "Restrict tools per role" for role-based examples.
# AZURE_DEVOPS_ENABLED_DOMAINS=work_items,tfvc,pipelines,convenience

# ---- Write safety ----

# Server-level write kill switch. "readonly" refuses all 7 write tools;
# reads unaffected. Useful for CI, demos, sandbox, emergency stop.
# AZURE_DEVOPS_MODE=readonly

# Append-only JSONL audit log of every write attempt (success, failure,
# dry-run, blocked). Unset = no audit log.
# AZURE_DEVOPS_AUDIT_LOG=/path/to/ado-audit.jsonl

# Redact mode for the audit log — keeps numeric IDs and field shape,
# drops all string values (titles, comments, branch names). For environments
# with strict data classification.
# AZURE_DEVOPS_AUDIT_REDACT=1

# Global write rate limit (sliding 60s window across all write tools).
# Default 10 writes/minute. Set to 0 to disable.
# AZURE_DEVOPS_RATE_LIMIT_WRITES_PER_MIN=10
